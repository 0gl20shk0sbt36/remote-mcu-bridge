{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "backend",
    "target",
    "defaults",
    "capabilities",
    "pins"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "backend": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "module-runtime",
          "resident-update",
          "spi",
          "uart",
          "wifi-management"
        ]
      }
    },
    "defaults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": -1
      }
    }
  }
}
