menu "RMB generic trusted-LAN resident"
config RMB_ENABLE
 bool "Enable resident network and module loader"
 default n
config RMB_WIFI_SSID
 string "Station Wi-Fi SSID"
 default ""
config RMB_WIFI_PASSWORD
 string "Station Wi-Fi password"
 default ""
config RMB_TOKEN
 string "LAN token (16-128 bytes)"
 default ""
config RMB_PORT
 int "Advertised default service port (module owns listener)"
 range 1024 65535
 default 3333
config RMB_LISTENER_STACK_BYTES
 int "Service listener task stack (bytes, per registered listener)"
 range 4096 32768
 default 12288
 help
  Includes the synchronous service callback, SDK drivers, logging and libc.
  The STM service overflowed a 6144-byte listener in real hardware tests.
  Monitor rmb-net stack_min_free_bytes after representative requests.
  Four listeners can be registered; stack allocation failure aborts init.
config RMB_DISCOVERY_PORT
 int "UDP discovery port"
 range 1024 65535
 default 3334
endmenu
rsource "../module/Kconfig.projbuild"
